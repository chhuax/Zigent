# Zig 构建产物（可重建，不入库）
.zig-cache/
zig-cache/
zig-out/

# 验证截图等产物（可重建，不入库）
output/

# Python 缓存
__pycache__/
*.pyc

# Playwright 临时会话
.playwright-cli/

# 设计文档与文档站（只在本机可用，不进 git、不公开）
#
# 注意：要发布的文档在 `docs/`，那个目录是**入库**的。
# 这里忽略的是 `design/` —— 设计稿、内部溯源材料、文档站产物。
# 两个目录刻意分开，而不是「忽略 docs/ 但开几个例外」：
# 后者的规则是「不公开，除了某几个」，下一个人很容易把不该公开的放进例外。
design/

# macOS
.DS_Store
